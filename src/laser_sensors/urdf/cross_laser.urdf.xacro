<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="cross_laser">

  <xacro:property name="laser_sensors_model_base" value="$(find laser_sensors)/model"/>

  <xacro:macro name="cross_laser" params="
    parent
    name:=captron
    tf_prefix:=''
    simulated:=true
    update_rate:=30.0
    *origin">

    <link name="${name}_laser_sensor_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <mesh filename="file://${laser_sensors_model_base}/captron/meshes/sensor_visual.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <mesh filename="file://${laser_sensors_model_base}/captron/meshes/sensor_collision.stl"/>
        </geometry>
      </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.5"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
        </inertial>
    </link>

    <joint name="${name}_laser_sensor_joint" type="fixed">
        <parent link="${tf_prefix}${parent}"/>
        <child link="${name}_laser_sensor_link"/>
        <xacro:insert_block name="origin"/>
    </joint>

    
  </xacro:macro>

</robot>