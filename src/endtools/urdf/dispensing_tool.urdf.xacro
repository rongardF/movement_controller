<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="dispensing">

  <xacro:property name="endtools_model_base" value="$(find endtools)/model"/>

  <xacro:macro name="dispensing" params="
    parent
    name:=dispensing
    tf_prefix:=''
    simulated:=true
    *origin">

    <link name="${name}_endtool_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <mesh filename="file://${endtools_model_base}/dispensing/meshes/endtool_visual.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <mesh filename="file://${endtools_model_base}/dispensing/meshes/endtool_collision.stl"/>
        </geometry>
      </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.5"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
        </inertial>
    </link>

    <joint name="${name}_endtool_joint" type="fixed">
        <parent link="${tf_prefix}${parent}"/>
        <child link="${name}_endtool_link"/>
        <xacro:insert_block name="origin"/>
    </joint>

    
  </xacro:macro>

</robot>