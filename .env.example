# .env.example
# Copy to .env and fill in real values — never commit .env
#
# Usage:
#   cp .env.example .env
#   docker compose --profile dev up

# ── ROS 2 Configuration ───────────────────────────────────────────────────
# Isolates DDS discovery from other ROS 2 instances on the same machine/LAN
ROS_DOMAIN_ID=42

# ── Workstation Identity ──────────────────────────────────────────────────
# Unique identifier for this workstation cell (used in traceability events)
WORKSTATION_ID=dev-workstation-01

# Gazebo environment variable to point to the model path for the simulation
GZ_SIM_RESOURCE_PATH="/workspaces/movement_controller/model"