{
  "name": "Workstation",
  "build": {
    "dockerfile": "../docker/Dockerfile",
    "context": "..",
    "options": [
      "--network=host"
    ]
  },
  "workspaceFolder": "/workspaces/autofactory",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/autofactory,type=bind,consistency=cached",
  "runArgs": [
    "--net=host",
    "--pid=host",
    "--ipc=host",
    // Requires NVIDIA Container Toolkit on host (nvidia-ctk runtime configure --runtime=docker)
    "--gpus=all"
  ],
  "containerEnv": {
    "ROS_DOMAIN_ID": "42",
    "ROS_AUTOMATIC_DISCOVERY_RANGE": "LOCALHOST",
    "RCUTILS_LOGGING_USE_STDOUT": "0",
    "DISPLAY": "${localEnv:DISPLAY}",
    "QT_X11_NO_MITSHM": "1",
    "QSG_RENDER_LOOP": "basic",
    "GZ_SIM_GUI_CONFIG_PATH": "/workspaces/autofactory/config/gz/gui.config",
    "GZ_IP": "127.0.0.1",
    "NVIDIA_VISIBLE_DEVICES": "all",
    "NVIDIA_DRIVER_CAPABILITIES": "graphics,utility,compute"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.pylance",
        "ms-iot.vscode-ros",
        "ms-vscode-remote.remote-containers",
        "ms-azuretools.vscode-docker",
        "github.copilot-chat"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python3",
        "python.analysis.extraPaths": [
          "${workspaceFolder}/install/lib/python3.12/site-packages",
          "${workspaceFolder}/install/lib/python3/site-packages"
        ],
        "editor.formatOnSave": true,
        "editor.rulers": [
          100
        ],
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        }
      }
    }
  },
  "postCreateCommand": "bash /workspaces/autofactory/docker/startup.sh"
}