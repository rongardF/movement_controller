<?xml version="1.0"?>
<tool_mount xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="tool_mount" params="
    parent:=tool0
    *origin
    ">

    <link name="tool_mount_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh>
                <uri>model://tool_mount/meshes/visual.dae</uri>
                </mesh>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh>
                <uri>model://tool_mount/meshes/collision.stl</uri>
                </mesh>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.5"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
        </inertial>
    </link>
    <!-- TODO: define a link for 'tool_mount_tcp' -->

    <joint name="tool_mount_joint" type="fixed">
        <parent link="$(arg parent)"/>
        <child link="tool_mount_link"/>
        <xacro:insert_block name="origin"/>
    </joint>
  </xacro:macro>
</tool_mount>